# NEXUSPROD AI — Frontend Environment Configuration Template
# Copy this file to .env in frontend/ for custom production endpoints

# Production FastAPI Backend API URL
# Example on Render: https://nexusprod-api.onrender.com/api
# If left empty in development, automatically defaults to http://localhost:8000/api
VITE_API_URL=

# Production Real-Time WebSocket URL
# Example on Render: wss://nexusprod-api.onrender.com
# If left empty, automatically derived from VITE_API_URL with wss:// protocol
VITE_WS_URL=
