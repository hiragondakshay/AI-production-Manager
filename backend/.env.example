# NEXUSPROD AI — Backend Environment Configuration Template
# Copy this file to .env in backend/ for local development

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# Database Connection URL
# Local SQLite default: sqlite:///./production_system.db
# Production Render PostgreSQL example: postgresql://nexusprod_user:password@dpg-xxxxx.singapore-postgres.render.com/nexusprod_db
DATABASE_URL=sqlite:///./production_system.db

# Cryptographic & JWT Secret Key (Set a strong 32+ character key in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# CORS Configuration (Comma-separated origins or * for wildcard)
# In production: https://your-frontend-app.onrender.com
ALLOWED_ORIGINS=*

# Factory Timezone (Defaults to Indian Standard Time)
FACTORY_TIMEZONE=Asia/Kolkata

# MQTT Broker (Optional - falls back gracefully if unreachable)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
